PORT=3000
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce
PGUSER=postgres
PGPASSWORD=postgres
UPLOAD_DIR=server/uploads
COOKIE_SECURE=false
PHOTO_STORAGE=local
# For Cloud Run, use INSTANCE_CONNECTION_NAME with PGDATABASE, PGUSER and PGPASSWORD.
# With PHOTO_STORAGE=gcs, set GCS_BUCKET and GCS_PREFIX (including its trailing slash).
