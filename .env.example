PORT=3000
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce
PGUSER=postgres
PGPASSWORD=postgres
UPLOAD_DIR=server/uploads
COOKIE_SECURE=false
PHOTO_STORAGE=local
