{
  "name": "ecommerce-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev:frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "ng serve",
    "dev:backend": "tsx watch server/main.ts",
    "build:frontend": "ng build",
    "build:backend": "tsc -p server/tsconfig.json",
    "db:init": "docker exec -i ecommerce-postgres psql -X -U postgres -d ecommerce -v ON_ERROR_STOP=1 < database/01_schema.sql",
    "db:seed": "docker exec -i ecommerce-postgres psql -X -U postgres -d ecommerce -v ON_ERROR_STOP=1 < database/02_seed.sql",
    "smoke": "node scripts/smoke.mjs",
    "build:function": "node scripts/build-function.mjs",
    "dev:function": "functions-framework --source=cloud-function --target=ahMarketplaceApi --signature-type=http",
    "package:vm": "sh scripts/package-vm.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@google-cloud/cloud-sql-connector": "^1.13.0",
    "@google-cloud/functions-framework": "^5.0.5",
    "@google-cloud/storage": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
